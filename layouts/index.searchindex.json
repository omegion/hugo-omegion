{{- $pages := (where site.RegularPages "Type" "in" (slice "posts" "projects")).ByDate.Reverse -}}
[
{{- range $i, $p := $pages -}}
  {{- if $i }},{{ end -}}
  {
    "title": {{ $p.Title | jsonify }},
    "url": {{ $p.RelPermalink | jsonify }},
    "date": {{ $p.Date.Format "Jan 2006" | jsonify }},
    "summary": {{ $p.Params.summary | default $p.Description | jsonify }},
    "section": {{ $p.Type | jsonify }},
    "tags": {{ $p.Params.tags | default (slice) | jsonify }}
  }
{{- end -}}
]
